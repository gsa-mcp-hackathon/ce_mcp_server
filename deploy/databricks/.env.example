# Databricks Apps deployment configuration for your MCP server.
#
# Copy to .env and fill in, then:
#   set -a; source deploy/databricks/.env; set +a
# before running the deploy script.
#
# This file contains NO secrets. Databricks authentication is handled by the
# Databricks CLI (an OAuth login or a DATABRICKS_TOKEN in your environment/CLI
# profile), NOT stored here.

# --- Databricks workspace -----------------------------------------------------
# Your workspace URL. Also settable via the CLI profile; if set here the deploy
# script passes it through.
#   DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_HOST=

# CLI profile to use (from `databricks auth login` / ~/.databrickscfg).
# This MUST match the profile name you chose during `databricks auth login`.
# NOTE: `databricks auth login` defaults the profile name to your workspace host
# (or whatever you type at its prompt), NOT "DEFAULT". Run `databricks auth
# profiles` to see your profile names and set this to the one for this workspace.
DATABRICKS_CONFIG_PROFILE=DEFAULT

# --- App identity -------------------------------------------------------------
# Name of the Databricks App (created on first deploy). Use your server's name;
# lowercase letters, numbers, and hyphens.
APP_NAME=example-mcp-server

# Workspace path where the app source code is uploaded (the deploy script syncs
# the repo here, then deploys from it). Must be an absolute workspace path.
# Replace <you> with your workspace username/email.
SOURCE_CODE_PATH=/Workspace/Users/<you>/example-mcp-server

# --- Record store (optional) --------------------------------------------------
# Where the app keeps request, resolved and outcome records. Leave
# RECORD_WAREHOUSE_ID empty to keep them as files in the app's container, where
# they are lost when the app restarts. Set it to keep them in Delta tables:
#   RECORD_WAREHOUSE_ID   ID of a SQL warehouse (`databricks warehouses list`)
#   RECORD_CATALOG        catalog of the tables
#   RECORD_SCHEMA         schema of the tables; one you own, such as your own
#                         schema in the `users` catalog
#   RECORD_TABLE_PREFIX   put before each table name (default ce_mcp_)
# See README.md, "Record store", for creating the tables and the grants.
RECORD_WAREHOUSE_ID=
RECORD_CATALOG=
RECORD_SCHEMA=
RECORD_TABLE_PREFIX=ce_mcp_
